*filter
:SHAKERPROXY-FORWARD - [0:0]
-A SHAKERPROXY-FORWARD -m conntrack --ctstate ESTABLISHED,RELATED -j ACCEPT
-A SHAKERPROXY-FORWARD -s 10.77.0.0/24 -j ACCEPT
-A SHAKERPROXY-FORWARD -d 10.77.0.0/24 -j DROP
COMMIT
*nat
:SHAKERPROXY-POSTROUTING - [0:0]
-A SHAKERPROXY-POSTROUTING -s 10.77.0.0/24 -j MASQUERADE
COMMIT
