[Unit]
Description=ShakerProxy outbound cloud connector
Documentation=https://github.com/andriyze/ShakerProxy
Wants=network-online.target shakerproxy-traffic-policy.service
After=network-online.target shakerproxy-gatewayd.service shakerproxy-traffic-policy.service

[Service]
Type=simple
User=shakerproxy-cloud
Group=shakerproxy-cloud
ExecStart=/usr/libexec/shakerproxy/shakerproxy-cloud-connector
Restart=on-failure
RestartSec=10s
StateDirectory=shakerproxy/cloud
StateDirectoryMode=0700
RuntimeDirectory=shakerproxy-cloud
RuntimeDirectoryMode=0750
Environment=SHAKERPROXY_CLOUD_STATE_ROOT=/var/lib/shakerproxy/cloud
Environment=SHAKERPROXY_CLOUD_CONNECTOR_SOCKET=/run/shakerproxy-cloud/connector.sock
EnvironmentFile=-/etc/shakerproxy/connector.env
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
UMask=0077
ReadOnlyPaths=-/run/shakerproxy-traffic-policy

[Install]
WantedBy=multi-user.target
