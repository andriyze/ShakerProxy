[Unit]
Description=ShakerProxy local DNS enforcement forwarder
Wants=network-online.target
After=network-online.target shakerproxy-gatewayd.service
Before=shakerproxy-app.service

[Service]
Type=simple
ExecStart=/usr/libexec/shakerproxy/shakerproxy-dnsd
Restart=on-failure
RestartSec=2s
User=shakerproxy-dns
Group=shakerproxy-dns
# /var/lib/shakerproxy/traffic is 0750 root:shakerproxy-cloud. The group grants read
# access to the shared runtime policy only: RestrictAddressFamilies excludes
# AF_UNIX, so no shakerproxy-cloud socket is reachable from this service.
SupplementaryGroups=shakerproxy-cloud
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectClock=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectHostname=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
ReadOnlyPaths=/var/lib/shakerproxy/traffic
# One event file per answered lab lookup, for Traffic (the "-" keeps the
# forwarder starting if the package has not created the spool yet).
ReadWritePaths=-/var/lib/shakerproxy/dns-events/pending
RestrictAddressFamilies=AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
