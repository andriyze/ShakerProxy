{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shakerproxy.local/network-plan/v1.schema.json",
  "title": "ShakerProxy network plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "topology", "interfaces", "management", "ipv4", "ipv6"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "topology": {"enum": ["TWO_NIC", "SINGLE_ARM", "THREE_INTERFACE", "VLAN_TRUNK", "EXISTING_ROUTED_VLAN", "PASSIVE_SENSOR", "ADVANCED_CUSTOM"]},
    "interfaces": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stable_id", "current_name", "role"],
        "properties": {
          "stable_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "current_name": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,64}$"},
          "role": {"enum": ["WAN", "LAB", "WAN_LAB", "MANAGEMENT", "MIRROR", "UNUSED", "WIFI_AP"]},
          "vlan_id": {"type": "integer", "minimum": 1, "maximum": 4094},
          "mtu": {"type": "integer", "minimum": 576, "maximum": 9216}
        }
      }
    },
    "management": {"type": "object", "additionalProperties": false, "required": ["preserve_active_ssh"], "properties": {"preserve_active_ssh": {"const": true}, "allowed_cidrs": {"type": "array", "maxItems": 64, "items": {"type": "string"}}}},
    "wan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ipv4_mode": {"enum": ["KEEP_EXISTING", "DHCP", "STATIC"]},
        "ipv4_address": {"type": "string"},
        "ipv4_gateway": {"type": "string"},
        "ipv6_mode": {"enum": ["KEEP_EXISTING", "SLAAC", "DHCPV6", "PREFIX_DELEGATION", "STATIC", "NONE"]},
        "ipv6_address": {"type": "string"},
        "ipv6_gateway": {"type": "string"},
        "requested_prefix_length": {"type": "integer", "minimum": 48, "maximum": 64},
        "dns_mode": {"enum": ["USE_DHCP", "IGNORE_DHCP", "BOOTSTRAP_ONLY"]},
        "upstream_nat": {"type": "boolean"},
        "clamp_mss": {"type": "boolean"},
        "allow_working_wan_change": {"type": "boolean"},
        "allow_cloud_init_override": {"type": "boolean"}
      }
    },
    "ipv4": {"type": "object", "additionalProperties": false, "required": ["enabled", "nat44", "client_isolation"], "properties": {"enabled": {"type": "boolean"}, "lab_cidr": {"type": "string"}, "gateway_address": {"type": "string"}, "dhcp_start": {"type": "string"}, "dhcp_end": {"type": "string"}, "dhcp_lease_seconds": {"type": "integer", "minimum": 60, "maximum": 604800}, "dns_addresses": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"type": "string"}}, "search_domain": {"type": "string", "maxLength": 253}, "reservations": {"type": "array", "maxItems": 1024, "items": {"type": "object", "additionalProperties": false, "required": ["hardware_address", "ip_address"], "properties": {"hostname": {"type": "string", "maxLength": 253}, "hardware_address": {"type": "string"}, "ip_address": {"type": "string"}}}}, "nat44": {"type": "boolean"}, "client_isolation": {"type": "boolean"}}},
    "ipv6": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy"],
      "properties": {
        "strategy": {"enum": ["NATIVE_ROUTED_PREFIX", "PREFIX_DELEGATION", "ULA_NAT66_LAB", "OBSERVE_ONLY", "DISABLED"], "description": "DISABLED drops forwarded lab IPv6 and sends no router advertisements; OBSERVE_ONLY leaves IPv6 unrouted without firewall changes; ULA_NAT66_LAB and NATIVE_ROUTED_PREFIX announce lab_prefix with SLAAC and RDNSS; PREFIX_DELEGATION is not available yet."},
        "lab_prefix": {"type": "string", "maxLength": 64, "description": "Required for ULA_NAT66_LAB (inside fd00::/8) and NATIVE_ROUTED_PREFIX (global unicast, routed to ShakerProxy). Exactly /64, for example fd12:3456:789a:1::/64."},
        "gateway_address": {"type": "string", "maxLength": 64, "description": "ShakerProxy's lab IPv6 address inside lab_prefix. Defaults to the prefix's ::1."},
        "dns_addresses": {"type": "array", "maxItems": 3, "uniqueItems": true, "items": {"type": "string", "maxLength": 64}, "description": "IPv6 DNS servers advertised with RDNSS. Defaults to the gateway address."}
      },
      "allOf": [
        {"if": {"properties": {"strategy": {"enum": ["ULA_NAT66_LAB", "NATIVE_ROUTED_PREFIX"]}}}, "then": {"required": ["lab_prefix"]}},
        {"if": {"properties": {"strategy": {"enum": ["DISABLED", "OBSERVE_ONLY", "PREFIX_DELEGATION"]}}}, "then": {"not": {"anyOf": [{"required": ["lab_prefix"]}, {"required": ["gateway_address"]}, {"required": ["dns_addresses"]}]}}}
      ]
    },
    "wifi": {
      "description": "Optional lab Wi-Fi access point. Omitted or enabled=false means no access point; when enabled, exactly one interface must have the WIFI_AP role.",
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "ssid": {"type": "string", "minLength": 1, "maxLength": 32, "description": "1 to 32 UTF-8 bytes without control characters."},
        "security": {"enum": ["WPA2_PSK", "WPA3_SAE", "WPA2_WPA3", "OPEN"]},
        "passphrase": {"type": "string", "pattern": "^[ -~]{8,63}$", "description": "8 to 63 printable ASCII characters; required unless security is OPEN."},
        "country_code": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2 code of the country where the access point is used."},
        "band": {"enum": ["2.4GHZ", "5GHZ"], "default": "2.4GHZ"},
        "channel": {"type": "integer", "description": "0 or omitted selects 6 on 2.4 GHz and 36 on 5 GHz. 2.4 GHz accepts 1-13; 5 GHz accepts only non-DFS channels.", "anyOf": [{"const": 0}, {"minimum": 1, "maximum": 13}, {"enum": [36, 40, 44, 48, 149, 153, 157, 161, 165]}]},
        "hidden": {"type": "boolean", "default": false},
        "client_isolation": {"type": "boolean", "default": false},
        "bridge_with_lab": {"type": "boolean", "default": false, "description": "With a wired LAB interface, join it and the access point in bridge lgbr0. Required when a wired LAB interface is present."}
      },
      "allOf": [
        {"if": {"properties": {"enabled": {"const": true}}}, "then": {"required": ["enabled", "ssid", "security", "country_code"]}},
        {"if": {"properties": {"enabled": {"const": true}, "security": {"enum": ["WPA2_PSK", "WPA3_SAE", "WPA2_WPA3"]}}, "required": ["enabled", "security"]}, "then": {"required": ["passphrase"]}}
      ]
    }
  }
}
