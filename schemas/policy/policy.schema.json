{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.shakerproxy.local/policy/v1.schema.json",
  "title": "ShakerProxy traffic policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "name", "revision", "rules"],
  "properties": {
    "schema": {"const": 1},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "revision": {"type": "integer", "minimum": 1},
    "rules": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "order", "action", "failure_behavior"],
        "properties": {
          "id": {"type": "string", "format": "uuid"},
          "order": {"type": "integer", "minimum": 0},
          "action": {"enum": ["ALLOW", "BLOCK", "CAPTURE_METADATA", "CAPTURE_HEADERS", "CAPTURE_FULL", "MITM_TLS", "PROXY_TCP", "PROXY_UDP_EXPERIMENTAL", "FORCE_LOCAL_DNS", "BLOCK_EXTERNAL_DNS", "BLOCK_QUIC", "RATE_LIMIT", "QUARANTINE", "REDACT_BODY", "DO_NOT_STORE_BODY"]},
          "failure_behavior": {"enum": ["FAIL_OPEN", "FAIL_CLOSED"]},
          "expires_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
