{
    admin off
    auto_https off
}

:8443 {
    bind 0.0.0.0
    encode zstd gzip
    @api path /api/* /healthz
    handle @api {
        reverse_proxy control-api:8080
    }
    handle {
        reverse_proxy web-ui:8080
    }
    header {
        -Server
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
    }
}
