[Unit]
Description=ShakerProxy managed Wi-Fi access point
Documentation=man:hostapd(8)
After=systemd-networkd.service NetworkManager.service shakerproxy-gatewayd.service
Before=shakerproxy-dhcp4.service
ConditionPathExists=/etc/shakerproxy/hostapd/shakerproxy.conf

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/sbin/hostapd /etc/shakerproxy/hostapd/shakerproxy.conf
Restart=on-failure
RestartSec=5s
UMask=0077
RuntimeDirectory=shakerproxy-hostapd
RuntimeDirectoryMode=0700
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_PACKET AF_INET AF_INET6
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
