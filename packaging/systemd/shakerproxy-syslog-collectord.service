[Unit]
Description=ShakerProxy network-gear syslog collector
Documentation=https://github.com/andriyze/ShakerProxy
After=shakerproxy-app.service network-online.target
Wants=network-online.target

# Off by default: this unit does nothing until the integration is enabled with
# an allowed source (from the dashboard, the API or `shakerproxy syslog enable`).
[Service]
Type=simple
User=shakerproxy-cloud
Group=shakerproxy-app
ExecStart=/usr/libexec/shakerproxy/shakerproxy-syslog-collectord
Restart=on-failure
RestartSec=3s
EnvironmentFile=-/etc/shakerproxy/syslog-collector.env
Environment=SHAKERPROXY_SYSLOG_STATUS_FILE=/var/lib/shakerproxy/syslog-collector/status.json
Environment=SHAKERPROXY_SYSLOG_CONFIG_FILE=/var/lib/shakerproxy/syslog-collector/config.json
# Events wait here for the syslog-event-forwarder container, which delivers
# them to ingestd; this service holds no ingest token.
Environment=SHAKERPROXY_SYSLOG_EVENT_SPOOL=/var/lib/shakerproxy/syslog-events/pending
# Binding 514 needs the capability; the default bind is 1514, which does not.
# Uncomment to listen on the privileged syslog port:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
# "-": a missing directory must not stop the unit from starting (a missing
# /run/secrets kept beta.31-34 in a start loop); the collector reports it
# in its status instead.
ReadWritePaths=-/var/lib/shakerproxy/syslog-collector -/var/lib/shakerproxy/syslog-events/pending

[Install]
WantedBy=multi-user.target
